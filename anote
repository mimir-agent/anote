#!/usr/bin/env python3
"""anote: linked, provenance-stamped markdown notes for an agent.

Notes are markdown files with a small frontmatter block. The files are the
source of truth; there is no database. Every note records who said it
(source), what it was true for (version), and when to look at it again
(review). Notes connect to each other with typed links.

Exit codes: 0 ok, 1 runtime error or failed check, 2 usage error,
3 note not found or ambiguous.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import sys
import tempfile
from pathlib import Path

LINK_TYPES = {
    "expands-on": "adds detail to, or builds out, the target",
    "explains": "makes the target understandable",
    "supports": "is evidence or argument for the target",
    "opposes": "is evidence or argument against the target",
    "relates": "is connected to the target in a way no other type names",
    "addresses": "responds to a question, problem or request in the target",
    "helpful-background": "context worth reading before the target",
    "leads-to": "the target follows from this",
    "supplemental": "optional extra material for the target",
    "duplicates": "says the same thing as the target",
    "references": "cites or points at the target",
}
TYPE_ALIASES = {
    "expands": "expands-on", "expand": "expands-on", "explain": "explains",
    "support": "supports", "oppose": "opposes", "relate": "relates",
    "related": "relates", "address": "addresses",
    "background": "helpful-background", "leads": "leads-to",
    "supplement": "supplemental", "duplicate": "duplicates",
    "reference": "references", "refs": "references",
}
SOURCES = ("told", "observed", "inferred")
DEFAULT_REVIEW = {"observed": "+60d", "inferred": "+30d", "told": "+180d"}
STANCES = ("held", "unheld")
SETTABLE = ("title", "type", "source", "stance", "version", "review", "tags")
META_ORDER = ["title", "type", "created", "updated", "source", "stance",
              "version", "review", "confirmed", "status", "tags",
              "supersedes", "superseded_by"]
NOTE_TYPES = {
    "reference": "a record of a piece of material: something read, watched or listened to",
    "hub": "a hand-kept collection of links to notes that share no other connection",
    "artifact": "writing you composed; add a form (post, message, ...) once the form is clear",
    "assertion": "a claim that can be challenged, as one idea; not anyone's position unless stance says so",
    "concept": "an abstraction other notes refer to by name, with no claim attached",
    "cycle": "one work cycle; what goes in it is defined elsewhere",
    "fragment": "a piece lifted from a reference that is worth its own note; links back to it",
    "person": "a person likely to be referenced more than a few times",
    "project": "tasks directed at a goal with a defined output",
    "protocol": "instructions written in advance for a scenario",
    "question": "something still unanswered; assertions answer it",
}
MEDIA = {"audio", "text", "video"}
FORMS = {"article": "text", "book": "text", "film": "video"}
LOG_LINE = re.compile(r"^- (\d{2}:\d{2}) \[(told|observed|inferred)\] (.*)$")

FRONTMATTER = re.compile(r"\A---\n(.*?)\n---[ \t]*\n?(.*)\Z", re.S)
LINK_LINE = re.compile(
    r"^\s*-\s+([a-z][a-z-]*)\s+\[\[([^\]]+)\]\](?:\s*\|\s*(.*))?$")
WIKILINK = re.compile(r"\[\[([^\]|]+)\]\]")
DATE_RE = re.compile(r"\d{4}-\d{2}-\d{2}")


class Fail(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code
        self.msg = msg


def die(code, msg):
    raise Fail(code, msg)


# ---------------------------------------------------------------- helpers

def today():
    env = os.environ.get("ANOTE_TODAY")
    return dt.date.fromisoformat(env) if env else dt.date.today()


def clean(s):
    return " ".join(s.split())


def slugify(s):
    s = re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
    return s[:70].strip("-")


def norm_type(t):
    t = re.sub(r"[\s_]+", "-", t.strip().lower())
    t = TYPE_ALIASES.get(t, t)
    if t not in LINK_TYPES:
        die(2, "unknown link type '%s'. Types: %s" % (t, ", ".join(LINK_TYPES)))
    return t


def check_type(raw):
    """Validate a type line and return it normalised, e.g. 'reference text article'."""
    w = [x.lstrip("#").lower() for x in re.split(r"[\s,]+", raw.strip()) if x.lstrip("#")]
    if not w:
        die(2, "type is empty. Types: %s" % ", ".join(NOTE_TYPES))
    head, rest = w[0], w[1:]
    if head not in NOTE_TYPES:
        die(2, "unknown note type '%s'. Types: %s" % (head, ", ".join(NOTE_TYPES)))
    if head == "reference":
        if rest and rest[0] not in MEDIA:
            if rest[0] in FORMS:
                die(2, "form '%s' goes after its media tag: reference %s %s" % (rest[0], FORMS[rest[0]], rest[0]))
            die(2, "reference media must be one of: %s" % ", ".join(sorted(MEDIA)))
        if len(rest) > 2:
            die(2, "a reference carries at most three tags: reference, media, form")
        if len(rest) == 2:
            if rest[1] not in FORMS:
                die(2, "unknown reference form '%s'. Forms: %s" % (rest[1], ", ".join(FORMS)))
            if FORMS[rest[1]] != rest[0]:
                die(2, "form '%s' goes with media '%s', not '%s'" % (rest[1], FORMS[rest[1]], rest[0]))
    elif head == "artifact":
        if len(rest) > 1:
            die(2, "an artifact carries at most one form tag")
        if rest and (not re.fullmatch(r"[a-z][a-z0-9-]*", rest[0]) or rest[0] in NOTE_TYPES):
            die(2, "'%s' is not a usable artifact form (try post, message or outline)" % rest[0])
    elif rest:
        die(2, "a %s note carries a single type tag, got extra: %s" % (head, " ".join(rest)))
    return " ".join(w)


def ntype(n):
    w = n.meta.get("type", "").split()
    return w[0].lstrip("#") if w else ""


def hashtags(raw):
    return " ".join("#" + x.lstrip("#") for x in raw.split())


def when(value, base=None):
    """'none' -> None; '+30d' / '2w' / '3m' (30-day months) or YYYY-MM-DD."""
    if value is None:
        return None
    v = value.strip().lower()
    if v in ("", "none"):
        return None
    m = re.fullmatch(r"\+?(\d+)([dwm])", v)
    if m:
        days = int(m.group(1)) * {"d": 1, "w": 7, "m": 30}[m.group(2)]
        return ((base or today()) + dt.timedelta(days=days)).isoformat()
    try:
        return dt.date.fromisoformat(v).isoformat()
    except ValueError:
        die(2, "cannot read date '%s' (use YYYY-MM-DD, +30d, +6w, +3m or none)" % value)


def write_text(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".tmp-", suffix=".md")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, str(path))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def graph_dir(a):
    raw = a.graph or os.environ.get("ANOTE_GRAPH") or "~/.hermes/graph"
    return Path(raw).expanduser()


# ------------------------------------------------------------ note model

class Note:
    def __init__(self, slug, meta, body, links):
        self.slug = slug
        self.meta = meta
        self.body = body
        self.links = links

    @property
    def title(self):
        return self.meta.get("title") or self.slug

    @property
    def tags(self):
        return [t.strip() for t in self.meta.get("tags", "").split(",") if t.strip()]

    @property
    def status(self):
        return self.meta.get("status", "active")


def parse(text, slug):
    m = FRONTMATTER.match(text)
    if not m:
        raise Fail(1, "%s.md: no frontmatter block" % slug)
    meta, links, in_links = {}, [], False
    for raw in m.group(1).split("\n"):
        if not raw.strip():
            continue
        if raw.strip() == "links:":
            in_links = True
            continue
        lm = LINK_LINE.match(raw)
        if in_links and lm:
            links.append({"type": lm.group(1), "to": lm.group(2).strip(),
                          "note": (lm.group(3) or "").strip()})
            continue
        key, sep, val = raw.partition(":")
        if not sep:
            raise Fail(1, "%s.md: cannot read line '%s'" % (slug, raw))
        meta[key.strip()] = val.strip()
        in_links = False
    return Note(slug, meta, m.group(2).strip("\n"), links)


def dump(n):
    lines = ["---"]
    for k in META_ORDER:
        if n.meta.get(k):
            lines.append("%s: %s" % (k, n.meta[k]))
    for k in sorted(set(n.meta) - set(META_ORDER)):
        lines.append("%s: %s" % (k, n.meta[k]))
    if n.links:
        lines.append("links:")
        for l in n.links:
            row = "  - %s [[%s]]" % (l["type"], l["to"])
            if l["note"]:
                row += " | " + l["note"]
            lines.append(row)
    lines.append("---")
    out = "\n".join(lines) + "\n"
    if n.body.strip():
        out += "\n" + n.body.strip("\n") + "\n"
    return out


def load_all(g, errors=None):
    d = g / "notes"
    notes = {}
    if not d.is_dir():
        return notes
    for p in sorted(d.glob("*.md")):
        if p.name.startswith("."):
            continue
        try:
            notes[p.stem] = parse(p.read_text(encoding="utf-8"), p.stem)
        except Fail as e:
            if errors is None:
                raise
            errors.append(e.msg)
    return notes


def save(g, n):
    write_text(g / "notes" / (n.slug + ".md"), dump(n))


def resolve(notes, ref):
    ref = ref.strip()
    if ref in notes:
        return ref
    low = clean(ref).lower()
    by_title = [s for s, n in notes.items() if clean(n.title).lower() == low]
    if len(by_title) == 1:
        return by_title[0]
    slugged = slugify(ref)
    if slugged in notes:
        return slugged
    prefix = [s for s in notes if slugged and s.startswith(slugged)]
    if len(prefix) == 1:
        return prefix[0]
    cands = sorted(set(by_title) | set(prefix))
    if cands:
        die(3, "'%s' is ambiguous: %s" % (ref, ", ".join(cands[:8])))
    die(3, "no note matches '%s'" % ref)


def incoming(notes):
    inc = {}
    for s, n in notes.items():
        for l in n.links:
            if l["to"] in notes:
                inc.setdefault(l["to"], []).append((s, l["type"], l["note"]))
    return inc


def touch(n):
    n.meta["updated"] = today().isoformat()


def emit(a, data, text):
    if a.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    elif text:
        print(text)


def review_phrase(rev):
    days = (dt.date.fromisoformat(rev) - today()).days
    if days < 0:
        return "overdue by %dd" % -days
    if days == 0:
        return "due today"
    return "in %dd" % days


# --------------------------------------------------------------- commands

def cmd_init(a):
    g = graph_dir(a)
    (g / "notes").mkdir(parents=True, exist_ok=True)
    (g / "daily").mkdir(parents=True, exist_ok=True)
    print("graph ready at %s" % g)


def cmd_types(a):
    rows = ["note types (one per note, --type):"]
    rows += ["  %-10s %s" % (k, v) for k, v in NOTE_TYPES.items()]
    rows += ["", "a reference adds media (%s), then a form (%s)" % (
        ", ".join(sorted(MEDIA)), ", ".join("%s=%s" % (f, m) for f, m in FORMS.items())),
        "", "link types:"]
    rows += ["  %-20s %s" % (k, v) for k, v in LINK_TYPES.items()]
    emit(a, {"note_types": NOTE_TYPES, "link_types": LINK_TYPES}, "\n".join(rows))


def type_from_args(a):
    words = [a.type]
    if a.media:
        words.append(a.media)
    if a.form:
        words.append(a.form)
    return check_type(" ".join(words))


def create_note(g, notes, a, title, body, source):
    title = clean(title)
    if not title:
        die(2, "title is empty")
    type_line = type_from_args(a)
    head = type_line.split()[0]
    if head == "person" and not a.person_ok:
        die(2, "person notes need --person-ok. Only for someone likely to be referenced "
               "more than a few times, and only with facts they would be fine with being "
               "recorded. Otherwise write the name as plain text in the log.")
    if a.stance and head != "assertion":
        die(2, "--stance only applies to assertions")
    slug = slugify(a.slug) if a.slug else slugify(title)
    if not slug:
        die(2, "could not make a slug from the title; pass --slug")
    if slug in notes:
        die(2, "'%s' already exists. Use `anote append %s ...` or pass --slug." % (slug, slug))
    links = []
    for spec in a.link or []:
        t, sep, target = spec.partition(":")
        if not sep:
            die(2, "--link wants TYPE:NOTE, got '%s'" % spec)
        links.append({"type": norm_type(t), "to": resolve(notes, target), "note": ""})
    if a.review is not None:
        review = when(a.review)
    else:
        review = when(DEFAULT_REVIEW[source])
    d = today().isoformat()
    meta = {"title": title, "type": type_line, "created": d, "updated": d,
            "source": source, "status": "active"}
    if a.stance:
        meta["stance"] = a.stance
    if a.version:
        meta["version"] = clean(a.version)
    if review:
        meta["review"] = review
    tags = sorted({slugify(t) for raw in (a.tag or []) for t in raw.split(",") if slugify(t)})
    if tags:
        meta["tags"] = ", ".join(tags)
    save(g, Note(slug, meta, body.strip("\n"), links))
    return slug


def cmd_add(a):
    g = graph_dir(a)
    notes = load_all(g)
    body = sys.stdin.read() if a.body == "-" else (a.body or "")
    slug = create_note(g, notes, a, a.title, body, a.source)
    print("created %s" % slug)


def append_log(g, text, source):
    day = today().isoformat()
    p = g / "daily" / (day + ".md")
    existing = p.read_text(encoding="utf-8") if p.exists() else "# %s\n\n" % day
    if not existing.endswith("\n"):
        existing += "\n"
    write_text(p, existing + "- %s [%s] %s\n" % (dt.datetime.now().strftime("%H:%M"), source, text))
    return day


def cmd_promote(a):
    g = graph_dir(a)
    if not DATE_RE.fullmatch(a.date):
        die(2, "date must be YYYY-MM-DD")
    p = g / "daily" / (a.date + ".md")
    if not p.exists():
        die(3, "no daily note for %s" % a.date)
    bullets = [l for l in p.read_text(encoding="utf-8").splitlines() if l.startswith("- ")]
    if not 1 <= a.line <= len(bullets):
        die(3, "line %d is out of range (1 to %d)" % (a.line, len(bullets)))
    raw = bullets[a.line - 1]
    m = LOG_LINE.match(raw)
    text = m.group(3) if m else raw[2:]
    source = a.source or (m.group(2) if m else None)
    if not source:
        die(2, "that line has no source tag; pass --source")
    slug = create_note(g, load_all(g), a, a.title, text, source)
    append_log(g, "promoted line %d of %s to [[%s]]" % (a.line, a.date, slug), "observed")
    print("promoted to %s" % slug)


def cmd_log(a):
    g = graph_dir(a)
    text = clean(" ".join(a.text))
    if not text:
        die(2, "nothing to log")
    day = append_log(g, text, a.source)
    print("logged to daily/%s" % day)


def cmd_link(a):
    g = graph_dir(a)
    notes = load_all(g)
    src, dst, t = resolve(notes, a.src), resolve(notes, a.dst), norm_type(a.type)
    if src == dst:
        die(2, "a note cannot link to itself")
    n = notes[src]
    for l in n.links:
        if l["to"] == dst and l["type"] == t:
            print("already linked: %s %s %s" % (src, t, dst))
            return
    n.links.append({"type": t, "to": dst, "note": clean(a.note or "")})
    touch(n)
    save(g, n)
    print("%s --%s--> %s" % (src, t, dst))


def cmd_unlink(a):
    g = graph_dir(a)
    notes = load_all(g)
    src, dst = resolve(notes, a.src), resolve(notes, a.dst)
    t = norm_type(a.type) if a.type else None
    n = notes[src]
    keep = [l for l in n.links if not (l["to"] == dst and (t is None or l["type"] == t))]
    removed = len(n.links) - len(keep)
    if not removed:
        die(3, "no link from %s to %s" % (src, dst))
    n.links = keep
    touch(n)
    save(g, n)
    print("removed %d link(s) from %s to %s" % (removed, src, dst))


def cmd_show(a):
    g = graph_dir(a)
    ref = a.note.strip()
    if DATE_RE.fullmatch(ref):
        p = g / "daily" / (ref + ".md")
        if not p.exists():
            die(3, "no daily note for %s" % ref)
        text = p.read_text(encoding="utf-8")
        count, view = 0, []
        for line in text.rstrip("\n").splitlines():
            if line.startswith("- "):
                count += 1
                line = "[%d] %s" % (count, line)
            view.append(line)
        emit(a, {"daily": ref, "content": text}, "\n".join(view))
        return
    notes = load_all(g)
    s = resolve(notes, ref)
    n = notes[s]
    inc = incoming(notes)
    out_links = [{"type": l["type"], "to": l["to"], "note": l["note"],
                  "title": notes[l["to"]].title if l["to"] in notes else None}
                 for l in n.links]
    in_links = [{"type": t, "from": f, "note": nt, "title": notes[f].title}
                for f, t, nt in inc.get(s, [])]
    data = {"slug": s, "meta": n.meta, "body": n.body, "links_out": out_links, "links_in": in_links}
    if a.json:
        emit(a, data, "")
        return
    lines = ["# %s  [%s]" % (n.title, s)]
    if n.meta.get("type"):
        lines.append("type: " + hashtags(n.meta["type"]))
    if ntype(n) == "assertion":
        lines.append("stance: " + (n.meta.get("stance") or "not stated (not anyone's position)"))
    bits = ["source: " + n.meta.get("source", "?")]
    for k in ("version", "created", "updated", "confirmed"):
        if n.meta.get(k):
            bits.append("%s: %s" % (k, n.meta[k]))
    rev = n.meta.get("review")
    if rev:
        bits.append("review: %s (%s)" % (rev, review_phrase(rev)))
    lines.append(" | ".join(bits))
    if n.tags:
        lines.append("tags: " + ", ".join(n.tags))
    if n.status != "active":
        lines.append("STATUS: %s%s" % (n.status, (" by [%s]" % n.meta["superseded_by"]) if n.meta.get("superseded_by") else ""))
    if n.meta.get("supersedes"):
        lines.append("supersedes: " + n.meta["supersedes"])
    if n.body:
        lines += ["", n.body]
    if out_links:
        lines += ["", "links out:"]
        for l in out_links:
            lines.append("  %-18s -> %s%s%s" % (
                l["type"], l["to"],
                ('  "%s"' % l["title"]) if l["title"] else "  (MISSING)",
                ("  | " + l["note"]) if l["note"] else ""))
    if in_links:
        lines += ["", "links in:"]
        for l in in_links:
            lines.append("  %-18s <- %s  \"%s\"%s" % (
                l["type"], l["from"], l["title"],
                ("  | " + l["note"]) if l["note"] else ""))
    print("\n".join(lines))


def score(doc, toks):
    t, b, tg = doc["title"].lower(), doc["body"].lower(), " ".join(doc["tags"]).lower()
    s = 0
    for k in toks:
        if k in t:
            s += 5
        if k in tg:
            s += 3
        s += min(b.count(k), 5)
    if s and all(k in (t + " " + b + " " + tg) for k in toks):
        s += 3
    return s


def snippet(body, toks, width=140):
    flat = " ".join(body.split())
    low = flat.lower()
    hits = [low.find(k) for k in toks if low.find(k) >= 0]
    pos = min(hits) if hits else 0
    start = max(0, pos - 40)
    chunk = flat[start:start + width]
    return ("..." if start > 0 else "") + chunk + ("..." if start + width < len(flat) else "")


def cmd_search(a):
    g = graph_dir(a)
    notes = load_all(g)
    toks = [t.lower() for t in a.query if t.strip()]
    docs = []
    for s, n in notes.items():
        if (n.status == "active" or a.all) and (not a.type or ntype(n) == a.type):
            docs.append({"slug": s, "title": n.title, "body": n.body, "tags": n.tags,
                         "kind": "note", "type": ntype(n), "source": n.meta.get("source", ""),
                         "updated": n.meta.get("updated", ""), "status": n.status,
                         "review": n.meta.get("review", "")})
    dd = g / "daily"
    if dd.is_dir() and not a.type:
        for p in sorted(dd.glob("*.md")):
            docs.append({"slug": "daily/" + p.stem, "title": p.stem, "tags": [],
                         "body": p.read_text(encoding="utf-8"), "kind": "daily",
                         "source": "log", "updated": p.stem, "status": "active", "review": ""})
    ranked = sorted(((score(d, toks), d) for d in docs), key=lambda x: (-x[0], x[1]["slug"]))
    results, used = [], 0
    for sc, d in ranked:
        if sc <= 0 or len(results) >= a.limit:
            break
        d = dict(d, score=sc, snippet=snippet(d["body"], toks))
        cost = (len(d["slug"]) + len(d["title"]) + len(d["snippet"]) + 30) // 4
        if a.budget and results and used + cost > a.budget:
            break
        used += cost
        results.append(d)
    if a.json:
        emit(a, [{k: v for k, v in r.items() if k != "body"} for r in results], "")
        return
    if not results:
        print("no matches")
        return
    out = []
    for r in results:
        flag = "" if r["status"] == "active" else " (%s)" % r["status"]
        out.append("%s  \"%s\"%s  [%s, %s]" % (r["slug"], r["title"], flag, r["source"], r["updated"]))
        out.append("    " + r["snippet"])
    print("\n".join(out))


def cmd_list(a):
    g = graph_dir(a)
    notes = load_all(g)
    inc = incoming(notes)
    rows = []
    for s, n in notes.items():
        if a.status != "all" and n.status != a.status:
            continue
        if a.tag and slugify(a.tag) not in n.tags:
            continue
        if a.type and ntype(n) != a.type:
            continue
        rows.append({"slug": s, "title": n.title, "type": ntype(n), "source": n.meta.get("source", ""),
                     "updated": n.meta.get("updated", ""), "status": n.status,
                     "out": len(n.links), "in": len(inc.get(s, []))})
    rows.sort(key=lambda r: (r["updated"], r["slug"]), reverse=True)
    if a.limit:
        rows = rows[:a.limit]
    emit(a, rows, "\n".join(
        "%-44s %s  %-9s %-10s o:%d i:%d  %s" % (
            r["slug"], r["updated"], r["source"], r["type"] or "-", r["out"], r["in"], r["title"])
        for r in rows) or "no notes")


def cmd_neighbors(a):
    g = graph_dir(a)
    notes = load_all(g)
    s = resolve(notes, a.note)
    inc = incoming(notes)
    tf = norm_type(a.type) if a.type else None
    edges, lines, seen = [], ["%s  \"%s\"" % (s, notes[s].title)], {s}

    def walk(cur, depth):
        if depth > a.depth:
            return
        found = []
        for l in notes[cur].links:
            if l["to"] in notes and (tf is None or l["type"] == tf):
                found.append(("out", l["type"], l["to"], l["note"]))
        for f, t, nt in inc.get(cur, []):
            if tf is None or t == tf:
                found.append(("in", t, f, nt))
        for d, t, other, nt in found:
            edges.append({"from": cur, "dir": d, "type": t, "other": other, "depth": depth})
            lines.append("%s%s %-18s %s  \"%s\"%s" % (
                "  " * depth, "->" if d == "out" else "<-", t, other, notes[other].title,
                ("  | " + nt) if nt else ""))
            if other not in seen:
                seen.add(other)
                walk(other, depth + 1)

    walk(s, 1)
    if len(lines) == 1:
        lines.append("  (no links)")
    emit(a, edges, "\n".join(lines))


def cmd_stale(a):
    g = graph_dir(a)
    notes = load_all(g)
    cutoff = when(a.within)
    cutoff = cutoff if cutoff else today().isoformat()
    due, undated = [], []
    for s, n in notes.items():
        if n.status != "active":
            continue
        rev = n.meta.get("review")
        if not rev:
            undated.append(s)
        elif rev <= cutoff:
            due.append({"slug": s, "review": rev, "source": n.meta.get("source", ""),
                        "version": n.meta.get("version", ""), "title": n.title})
    due.sort(key=lambda r: r["review"])
    text = []
    for r in due:
        text.append("%-44s review %s (%s)  %s%s" % (
            r["slug"], r["review"], review_phrase(r["review"]), r["source"],
            ("  " + r["version"]) if r["version"] else ""))
    if undated:
        text.append("no review date: " + ", ".join(sorted(undated)))
    emit(a, {"due": due, "undated": sorted(undated)}, "\n".join(text) or "nothing due")


def cmd_confirm(a):
    g = graph_dir(a)
    notes = load_all(g)
    n = notes[resolve(notes, a.note)]
    review = when(a.review) if a.review is not None else when(DEFAULT_REVIEW.get(n.meta.get("source", "observed"), "+60d"))
    n.meta["confirmed"] = today().isoformat()
    if review:
        n.meta["review"] = review
    else:
        n.meta.pop("review", None)
    if a.version:
        n.meta["version"] = clean(a.version)
    touch(n)
    save(g, n)
    print("confirmed %s%s" % (n.slug, (", next review " + review) if review else ""))


def cmd_set(a):
    g = graph_dir(a)
    notes = load_all(g)
    n = notes[resolve(notes, a.note)]
    k, v = a.key, a.value
    if k not in SETTABLE:
        die(2, "can set: %s" % ", ".join(SETTABLE))
    if k == "type":
        new_type = check_type(v)
        if new_type.split()[0] == "person":
            die(2, "person notes are created with `add --type person --person-ok`")
        n.meta[k] = new_type
        if n.meta.get("stance") and new_type.split()[0] != "assertion":
            n.meta.pop("stance")
    elif k == "stance":
        if ntype(n) != "assertion":
            die(2, "stance only applies to assertions")
        if v == "none":
            n.meta.pop(k, None)
        elif v in STANCES:
            n.meta[k] = v
        else:
            die(2, "stance must be one of: %s, or none" % ", ".join(STANCES))
    elif k == "source":
        if v not in SOURCES:
            die(2, "source must be one of: %s" % ", ".join(SOURCES))
        n.meta[k] = v
    elif k == "review":
        r = when(v)
        if r:
            n.meta[k] = r
        else:
            n.meta.pop(k, None)
    elif k == "tags":
        n.meta[k] = ", ".join(sorted({slugify(t) for t in v.split(",") if slugify(t)}))
        if not n.meta[k]:
            n.meta.pop(k)
    else:
        n.meta[k] = clean(v)
    touch(n)
    save(g, n)
    print("set %s on %s" % (k, n.slug))


def cmd_append(a):
    g = graph_dir(a)
    notes = load_all(g)
    n = notes[resolve(notes, a.note)]
    text = sys.stdin.read() if a.text == ["-"] else " ".join(a.text)
    if not text.strip():
        die(2, "nothing to append")
    n.body = (n.body.rstrip("\n") + "\n\n" + text.strip("\n")).strip("\n")
    touch(n)
    save(g, n)
    print("appended to %s" % n.slug)


def cmd_supersede(a):
    g = graph_dir(a)
    notes = load_all(g)
    old, new = resolve(notes, a.old), resolve(notes, a.new)
    if old == new:
        die(2, "a note cannot supersede itself")
    o, n = notes[old], notes[new]
    o.meta["status"] = "superseded"
    o.meta["superseded_by"] = new
    prior = [x for x in n.meta.get("supersedes", "").split(",") if x.strip()]
    n.meta["supersedes"] = ", ".join(sorted(set(x.strip() for x in prior) | {old}))
    touch(o)
    touch(n)
    save(g, o)
    save(g, n)
    print("%s is superseded by %s" % (old, new))


def cmd_check(a):
    g = graph_dir(a)
    errs = []
    notes = load_all(g, errors=errs)
    issues = [{"level": "error", "note": "", "message": m} for m in errs]
    inc = incoming(notes)

    def add(level, note, msg):
        issues.append({"level": level, "note": note, "message": msg})

    for s, n in notes.items():
        if n.meta.get("source") not in SOURCES:
            add("error", s, "source is missing or not one of %s" % "/".join(SOURCES))
        head = ntype(n)
        if not n.meta.get("type"):
            add("warn", s, "no type")
        else:
            try:
                check_type(n.meta["type"])
            except Fail as e:
                add("error", s, e.msg)
        if n.meta.get("stance") and (n.meta["stance"] not in STANCES or head != "assertion"):
            add("error", s, "stance is only for assertions and must be held or unheld")
        if head == "fragment" and not any(
                l["to"] in notes and ntype(notes[l["to"]]) == "reference" for l in n.links):
            add("error", s, "a fragment must link back to the reference it came from")
        if head == "artifact" and not n.links:
            add("warn", s, "an artifact should link to what it draws on")
        if head == "hub" and len(n.links) < 2:
            add("warn", s, "a hub should link to at least two notes")
        if head == "assertion" and n.title.strip().endswith("?"):
            add("warn", s, "title reads as a question; is this a question note?")
        for k in ("created", "updated", "review", "confirmed"):
            v = n.meta.get(k)
            if v:
                try:
                    dt.date.fromisoformat(v)
                except ValueError:
                    add("error", s, "%s is not a date: %s" % (k, v))
        for l in n.links:
            if l["type"] not in LINK_TYPES:
                add("error", s, "unknown link type '%s'" % l["type"])
            if l["to"] not in notes:
                add("error", s, "link to missing note '%s'" % l["to"])
        if n.status == "superseded":
            sb = n.meta.get("superseded_by")
            if not sb:
                add("error", s, "superseded but superseded_by is not set")
            elif sb not in notes:
                add("error", s, "superseded_by points at missing note '%s'" % sb)
        for w in sorted(set(WIKILINK.findall(n.body))):
            if slugify(w) not in notes and w.strip() not in notes:
                add("warn", s, "body mentions [[%s]] but no such note" % w)
        if n.status == "active" and not n.meta.get("review"):
            add("warn", s, "no review date")
        if n.status == "active" and not n.links and not inc.get(s):
            add("info", s, "no links in or out")
    order = {"error": 0, "warn": 1, "info": 2}
    issues.sort(key=lambda i: (order[i["level"]], i["note"]))
    counts = {k: sum(1 for i in issues if i["level"] == k) for k in order}
    text = ["%-5s %s%s" % (i["level"], (i["note"] + ": ") if i["note"] else "", i["message"]) for i in issues]
    text.append("%d notes, %d errors, %d warnings, %d info" % (len(notes), counts["error"], counts["warn"], counts["info"]))
    emit(a, {"notes": len(notes), "counts": counts, "issues": issues}, "\n".join(text))
    return 1 if counts["error"] else 0


# ----------------------------------------------------------------- parser

def note_args(sp):
    sp.add_argument("--type", required=True, choices=sorted(NOTE_TYPES),
                    help="what kind of note this is; run `anote types` for the definitions")
    sp.add_argument("--media", choices=sorted(MEDIA), help="references only: audio, text or video")
    sp.add_argument("--form", help="reference form (article, book, film) or artifact form (post, message, ...)")
    sp.add_argument("--stance", choices=STANCES,
                    help="assertions only: held = I stand behind it; unheld = recorded, not my position")
    sp.add_argument("--person-ok", action="store_true",
                    help="required for person notes; see `anote add --help`")


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--graph", help="graph directory (default $ANOTE_GRAPH or ~/.hermes/graph)")
    common.add_argument("--json", action="store_true", help="machine-readable output")
    p = argparse.ArgumentParser(prog="anote", description=__doc__.strip().splitlines()[0])
    sub = p.add_subparsers(dest="cmd", required=True, metavar="command")

    def cmd(name, fn, help_):
        sp = sub.add_parser(name, parents=[common], help=help_, description=help_)
        sp.set_defaults(fn=fn)
        return sp

    cmd("init", cmd_init, "create the graph directories")
    cmd("types", cmd_types, "list link types and what they mean")

    sp = cmd("add", cmd_add, "create a typed note (type and source are required). "
                             "New content belongs in the daily log unless it meets a type's definition.")
    sp.add_argument("title")
    note_args(sp)
    sp.add_argument("--source", required=True, choices=SOURCES,
                    help="told = a person said it; observed = I saw it happen; inferred = I concluded it")
    sp.add_argument("--body", help="note text, or - to read stdin")
    sp.add_argument("--version", help="what this was true for, e.g. 'hermes 0.19.0'")
    sp.add_argument("--review", help="YYYY-MM-DD, +30d, +6w, +3m or none (default depends on source)")
    sp.add_argument("--tag", action="append", help="repeatable or comma-separated")
    sp.add_argument("--link", action="append", help="TYPE:NOTE, repeatable")
    sp.add_argument("--slug", help="override the filename slug")

    sp = cmd("log", cmd_log, "append a line to today's daily log, the default place for anything new")
    sp.add_argument("text", nargs="+")
    sp.add_argument("--source", choices=SOURCES, default="observed")

    sp = cmd("promote", cmd_promote, "turn a daily log line into a typed note")
    sp.add_argument("date", help="YYYY-MM-DD")
    sp.add_argument("line", type=int, help="bullet number as shown by `anote show DATE`")
    sp.add_argument("title")
    note_args(sp)
    sp.add_argument("--source", choices=SOURCES, help="default: the source tag on the log line")
    sp.add_argument("--version")
    sp.add_argument("--review")
    sp.add_argument("--tag", action="append")
    sp.add_argument("--link", action="append")
    sp.add_argument("--slug")

    sp = cmd("link", cmd_link, "link one note to another with a typed link")
    sp.add_argument("src")
    sp.add_argument("type")
    sp.add_argument("dst")
    sp.add_argument("--note", help="why, in a few words")

    sp = cmd("unlink", cmd_unlink, "remove links from one note to another")
    sp.add_argument("src")
    sp.add_argument("dst")
    sp.add_argument("--type")

    sp = cmd("show", cmd_show, "print a note with its links in and out (or a daily note by date)")
    sp.add_argument("note")

    sp = cmd("search", cmd_search, "ranked search over notes and daily logs")
    sp.add_argument("query", nargs="+")
    sp.add_argument("--limit", type=int, default=10)
    sp.add_argument("--budget", type=int, default=0, help="stop after roughly this many tokens of output")
    sp.add_argument("--all", action="store_true", help="include superseded notes")
    sp.add_argument("--type", help="only notes of this type (daily logs are skipped)")

    sp = cmd("list", cmd_list, "list notes, newest first")
    sp.add_argument("--tag")
    sp.add_argument("--type", help="only notes of this type")
    sp.add_argument("--status", choices=("active", "superseded", "all"), default="active")
    sp.add_argument("--limit", type=int, default=0)

    sp = cmd("neighbors", cmd_neighbors, "walk the link web out from a note")
    sp.add_argument("note")
    sp.add_argument("--depth", type=int, default=1)
    sp.add_argument("--type", help="only follow this link type")

    sp = cmd("stale", cmd_stale, "notes whose review date has arrived")
    sp.add_argument("--within", default="0d", help="also include reviews due within this window, e.g. 14d")

    sp = cmd("confirm", cmd_confirm, "mark a note re-checked and push its review date out")
    sp.add_argument("note")
    sp.add_argument("--review")
    sp.add_argument("--version")

    sp = cmd("set", cmd_set, "change title, source, version, review or tags")
    sp.add_argument("note")
    sp.add_argument("key")
    sp.add_argument("value")

    sp = cmd("append", cmd_append, "add text to the end of a note")
    sp.add_argument("note")
    sp.add_argument("text", nargs="+", help="text, or - to read stdin")

    sp = cmd("supersede", cmd_supersede, "retire a note in favor of a newer one")
    sp.add_argument("old")
    sp.add_argument("new")

    cmd("check", cmd_check, "lint the graph: broken links, bad dates, missing provenance")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args) or 0
    except Fail as e:
        print("anote: " + e.msg, file=sys.stderr)
        return e.code
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
